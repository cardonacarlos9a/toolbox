{
  "name": "drive-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Remote MCP server that reads and edits text files in one Google Drive folder, in place.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "token": "npm run build && node dist/scripts/get-refresh-token.js"
  },
  "dependencies": {
    "@googleapis/drive": "^27.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
